<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Veinmine</AssemblyName>
    <RootNamespace>Veinmine</RootNamespace>
    <Version>0.2.2</Version>
    <Deterministic>true</Deterministic>
    <ValheimGamePath Condition="'$(ValheimGamePath)' == ''">$(VALHEIM_GAME_PATH)</ValheimGamePath>
    <ValheimManagedPath Condition="'$(ValheimManagedPath)' == ''">$(ValheimGamePath)/valheim_Data/Managed</ValheimManagedPath>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(ValheimGamePath)/BepInEx</BepInExPath>
    <ThunderstorePackageName>StrVeinMine</ThunderstorePackageName>
    <ReleaseOutputPath Condition="'$(ReleaseOutputPath)' == ''">$(MSBuildProjectDirectory)/Thunderstore</ReleaseOutputPath>
    <ThunderstorePackageDirectory>$(BaseIntermediateOutputPath)Thunderstore/$(ThunderstorePackageName)-$(Version)</ThunderstorePackageDirectory>
    <ThunderstorePackageArchive>$(ReleaseOutputPath)/$(ThunderstorePackageName)-$(Version).zip</ThunderstorePackageArchive>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ServerSync">
      <HintPath>libs/ServerSync.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>$(ValheimManagedPath)/assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils" Publicize="true">
      <HintPath>$(ValheimManagedPath)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ValheimManagedPath)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateValheimReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManagedPath)/assembly_valheim.dll')"
           Text="Valheim managed assemblies were not found. Set ValheimGamePath or ValheimManagedPath to a current Valheim installation." />
    <Error Condition="!Exists('$(BepInExPath)/core/BepInEx.dll')"
           Text="BepInEx was not found. Set BepInExPath to the current Valheim BepInEx installation." />
    <Error Condition="!Exists('libs/ServerSync.dll')"
           Text="The required ServerSync runtime dependency is missing from libs/ServerSync.dll." />
  </Target>

  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ThunderstorePackageFiles Include="$(TargetPath)" />
      <ThunderstorePackageFiles Include="$(TargetDir)ServerSync.dll" />
      <ThunderstorePackageFiles Include="$(MSBuildProjectDirectory)/Thunderstore/README.md" />
      <ThunderstorePackageFiles Include="$(MSBuildProjectDirectory)/Thunderstore/CHANGELOG.md" />
      <ThunderstorePackageFiles Include="$(MSBuildProjectDirectory)/Thunderstore/manifest.json" />
      <ThunderstorePackageFiles Include="$(MSBuildProjectDirectory)/Thunderstore/icon.png" />
    </ItemGroup>
    <RemoveDir Directories="$(ThunderstorePackageDirectory)" />
    <MakeDir Directories="$(ThunderstorePackageDirectory)" />
    <MakeDir Directories="$(ReleaseOutputPath)" />
    <Copy SourceFiles="@(ThunderstorePackageFiles)"
          DestinationFiles="@(ThunderstorePackageFiles->'$(ThunderstorePackageDirectory)/%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(ThunderstorePackageDirectory)"
                  DestinationFile="$(ThunderstorePackageArchive)"
                  Overwrite="true" />
    <RemoveDir Directories="$(ThunderstorePackageDirectory)" />
  </Target>
</Project>
